<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nm_report_ai_editor" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nm.report.ai.editor</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="NM Report AI Editor" string="NM Report AI Editor"
                     name="nm_report_ai_editor" groups="base.group_system">
                    <block title="Conexión con la IA" name="nm_ai_connection_block">
                        <setting id="nm_ai_api_key_setting"
                                 string="Clave API"
                                 help="Clave API de Anthropic. Se guarda en los parámetros del sistema.">
                            <field name="nm_ai_api_key" password="True"/>
                        </setting>
                        <setting id="nm_ai_model_setting"
                                 string="Modelo"
                                 help="Identificador del modelo que se usará para generar los cambios.">
                            <field name="nm_ai_model"/>
                        </setting>
                        <setting id="nm_ai_timeout_setting"
                                 string="Tiempo máximo de espera"
                                 help="Segundos que se espera la respuesta antes de dar error.">
                            <field name="nm_ai_timeout"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>